# Root environment file consumed by docker-compose.yml / docker-compose.prod.yml.
# Copy to `.env` and adjust. Never commit the real `.env` file.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Used by the backend container; must match the credentials above.
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@db:5432/portfolio

# --- Backend ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=*
CONTACT_RECIPIENT_EMAIL=danielemario@areddu.it
CONTACT_RATE_LIMIT_PER_HOUR=5
PUBLIC_SITE_URL=http://localhost:8080

# SMTP: Mailpit in development (see docker-compose.yml). In production, point
# these at a real transactional SMTP provider — do not use Mailpit.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_SENDER=no-reply@areddu.it

# --- Admin / CMS authentication ---------------------------------------------
# Fernet key encrypting TOTP secrets at rest. The value below is a published,
# dev-only key — generate a real one for any non-dev deployment with:
#   python -c "from cryptography.fernet import Fernet as F; print(F.generate_key().decode())"
ADMIN_TOTP_ENCRYPTION_KEY=fGh_Xp7R2VXN4o-pnC2FE6B7MFIPEhqTIsQGVfujB74=
# There is no default admin account and no sign-up endpoint. Create the first
# administrator with: docker compose exec backend uv run python -m app.cli create-admin
# (see docs/admin-guide.md).

# --- Frontend build args --------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Set before a production deploy. Left empty here on purpose — no domain is
# invented for you.
VITE_SITE_URL=

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
