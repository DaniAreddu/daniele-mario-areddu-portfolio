# Base URL the browser uses to reach the API. In development the Vite dev
# server proxies /api to VITE_API_PROXY_TARGET (see vite.config.ts); in
# production this is normally left empty so requests go through Nginx at
# the same origin (/api/...).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api requests to.
VITE_API_PROXY_TARGET=http://localhost:8000

# MapLibre style URL. Defaults to an open, no-API-key-required basemap.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Canonical production site URL, used to build canonical/OG/hreflang tags and
# JSON-LD. Leave empty in development. Daniele must set this before launch —
# no domain is invented here.
VITE_SITE_URL=
